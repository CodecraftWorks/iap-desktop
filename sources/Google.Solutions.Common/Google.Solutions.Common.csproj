<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Google.Solutions.IapDesktop.props" />
  <PropertyGroup>
    <!--
      Target net47 for the existing Windows application and net8.0
      for the new macOS application and cross-platform tooling.
    -->
    <TargetFrameworks>net47;net8.0</TargetFrameworks>
    <AssemblyTitle>$(ProjectName)</AssemblyTitle>
    <Description>Base class library</Description>
    <Platforms>x64;x86;ARM64</Platforms>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net47'">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <!--
    LocalAllocSafeHandle uses kernel32.dll P/Invoke which is Windows-only.
    Exclude it on non-Windows (e.g. macOS/net8.0) builds; all callers
    of LocalAllocSafeHandle are themselves Windows-only code paths.
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net47'">
    <Compile Remove="Interop\LocalAllocSafeHandle.cs" />
  </ItemGroup>
</Project>